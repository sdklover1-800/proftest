ENVIRONMENT=development
PROJECT_NAME=proftest

# Database
# For production set DATABASE_URL from your platform secret storage.
# Example: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://postgres:admin@localhost:5432/proftest
# Optional. If omitted, backend will derive sync URL from DATABASE_URL.
SYNC_DATABASE_URL=

# Security
SECRET_KEY=replace-with-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# CORS
# Development example:
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BACKEND_CORS_ORIGIN_REGEX=
BACKEND_CORS_ALLOW_CREDENTIALS=False

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_TOKENS=900
OPENAI_CACHE_TTL_SECONDS=604800
OPENAI_CACHE_MAX_ITEMS=2000
