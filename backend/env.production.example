ENVIRONMENT=production
PROJECT_NAME=proftest

# Database
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/proftest
# Optional. If empty, backend derives sync URL from DATABASE_URL.
SYNC_DATABASE_URL=

# Security
SECRET_KEY=CHANGE_ME_TO_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# CORS / Domain
BACKEND_CORS_ORIGINS=https://proftest.app,https://www.proftest.app
BACKEND_CORS_ORIGIN_REGEX=
BACKEND_CORS_ALLOW_CREDENTIALS=False
BACKEND_TRUSTED_HOSTS=proftest.app,www.proftest.app

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_TOKENS=900
OPENAI_CACHE_TTL_SECONDS=604800
OPENAI_CACHE_MAX_ITEMS=2000
